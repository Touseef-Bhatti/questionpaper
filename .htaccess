# Force PHP 8.1 for this subdomain
AddHandler application/x-httpd-ea-php81 .php

<IfModule php_module>
    php_value upload_max_filesize 128M
    php_value post_max_size 140M
    php_value memory_limit 512M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_flag display_errors Off
</IfModule>

# Default index file
DirectoryIndex index.php

# Disable directory browsing
Options -Indexes

# Protect .env files (any variant) in this directory
<FilesMatch "^\.env(\..*)?$">
    Require all denied
</FilesMatch>

# Block access to common backup/archive files
<FilesMatch "\.(bak|sql|tar|gz|zip)$">
    Require all denied
</FilesMatch>

# Block maintenance and development scripts from public requests.
<FilesMatch "^(test_mailhog|show_mcqs_table|setup_.*|debug_.*|test_.*|fix_.*|migrate.*|run_migration|add_column)\.(php|js)$">
    Require all denied
</FilesMatch>

# Allow this filename through the generic test-file deny rule. The relocated
# MCQ diagnostics page enforces admin authentication in PHP.
<Files "test_mcq_generation.php">
    Require all granted
</Files>
<Files "test_nvidia_direct.php">
    Require all granted
</Files>

# SEO-Optimized URL Rewriting
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    Options -MultiViews

    # Directory URLs are not public pages. Redirect legacy folder requests
    # directly to the HTTPS, non-www landing pages in one hop.
    RewriteRule ^questionPaperFromTopic/?$ https://ahmadlearninghub.com.pk/online-question-paper-generator [R=301,L,NE,QSD,NC]
    RewriteRule ^notes/?$ https://ahmadlearninghub.com.pk/study-material-for-board-exam-preparations [R=301,L,NE,QSD,NC]

    # Retire legacy MCQ URLs and malformed crawl candidates.
    RewriteRule ^class-([0-9]+)-([a-zA-Z0-9-]+)-mcqs-2026/?$ https://ahmadlearninghub.com.pk/class-$1-$2-mcqs-test-2026 [R=301,L,NE,QSD,NC]
    RewriteRule ^mcqs/online-mcqs-test-for-9th-and-10th-board-exams/?$ https://ahmadlearninghub.com.pk/online-mcqs-test-for-9th-and-10th-board-exams [R=301,L,NE,QSD,NC]
    RewriteRule ^notes/notes\.php/?$ https://ahmadlearninghub.com.pk/study-material-for-board-exam-preparations [R=301,L,NE,QSD,NC]
    RewriteRule ^topic-wise-mcqs-test-2026/?$ https://ahmadlearninghub.com.pk/topic-wise-mcqs-test [R=301,L,NE,QSD,NC]
    RewriteRule ^class-[0-9]+-$ - [G,L,NC]
    RewriteRule ^class-$ - [G,L,NC]
    RewriteRule ^reset_and_go\.php$ - [G,L,NC]

    # Retire both bare legacy MCQ listing entrypoints. Parameterized legacy
    # requests are still handled by notes/mcqs.php and redirected by its
    # class/book/chapter resolver.
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{QUERY_STRING} ^$
    RewriteCond %{THE_REQUEST} \s/+mcqs\.php(?:[\s?]) [NC]
    RewriteRule ^mcqs\.php$ https://ahmadlearninghub.com.pk/class-9-10-11-12-mcqs-for-board-exams [R=301,L,NE,QSD,NC]
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{QUERY_STRING} ^$
    RewriteCond %{THE_REQUEST} \s/+notes/mcqs\.php(?:[\s?]) [NC]
    RewriteRule ^notes/mcqs\.php$ https://ahmadlearninghub.com.pk/class-9-10-11-12-mcqs-for-board-exams [R=301,L,NE,QSD,NC]

    # A bare question-review endpoint has no selection to review. Send only
    # that direct GET to the public generator; valid parameterized workflows
    # and POST submissions continue to use select_question.php.
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{QUERY_STRING} ^$
    RewriteCond %{THE_REQUEST} \s/+select_question\.php(?:[\s?]) [NC]
    RewriteRule ^select_question\.php$ https://ahmadlearninghub.com.pk/class-9th-and-10th-online-question-paper-generator [R=301,L,NE,QSD,NC]

    # The upload endpoint is a POST-only JSON action. Redirect crawler GETs
    # from both its legacy paths without affecting real upload submissions.
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteRule ^(?:questionPaperFromTopic/)?generate_from_upload\.php$ https://ahmadlearninghub.com.pk/online-question-paper-generator [R=301,L,NE,QSD,NC]

    # Newsletter signup is a POST-only API endpoint. Redirect direct crawler
    # GETs to the public site while preserving real subscription submissions.
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteRule ^newsletter-signup(?:\.php)?$ https://ahmadlearninghub.com.pk/ [R=301,L,NE,QSD,NC]

    # Use one production origin for production-host requests only. Local
    # development hosts such as localhost:8001 must remain local.
    RewriteCond %{HTTP_HOST} ^(?:www\.)?ahmadlearninghub\.com\.pk$ [NC]
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} ^www\.ahmadlearninghub\.com\.pk$ [NC]
    RewriteRule ^ https://ahmadlearninghub.com.pk%{REQUEST_URI} [R=301,L,NE]

    # Collapse legacy root-file and extensionless URLs onto their public
    # landing pages. These endpoints otherwise create duplicate candidates
    # even when the page contains a canonical tag.
    RewriteCond %{THE_REQUEST} \s/+index\.php(?:[?\s]) [NC]
    RewriteRule ^index\.php$ / [R=301,L,NE,QSD]
    RewriteCond %{THE_REQUEST} \s/+index(?:[?\s]) [NC]
    RewriteRule ^index/?$ / [R=301,L,NE,QSD]
    RewriteCond %{THE_REQUEST} \s/+home(?:[?\s]) [NC]
    RewriteRule ^home/?$ /online-question-paper-generator [R=301,L,NE,QSD]
    RewriteCond %{THE_REQUEST} \s/+reviews\.php(?:[?\s]) [NC]
    RewriteRule ^reviews\.php$ /reviews [R=301,L,NE,QSD]
    RewriteCond %{THE_REQUEST} \s/+select_class(?:\.php)?(?:[?\s]) [NC]
    RewriteRule ^select_class(?:\.php)?$ /class-9th-and-10th-online-question-paper-generator [R=301,L,NE,QSD]
    RewriteCond %{THE_REQUEST} \s/+select_book(?:\.php)?(?:[?\s]) [NC]
    RewriteCond %{QUERY_STRING} (^|&)class_id=([0-9]+)(&|$) [NC]
    RewriteRule ^select_book(?:\.php)?$ /class-%2-online-question-paper-generator [R=301,L,NE,QSD]
    RewriteCond %{THE_REQUEST} \s/+select_book(?:\.php)?(?:[?\s]) [NC]
    RewriteRule ^select_book(?:\.php)?$ /class-9th-and-10th-online-question-paper-generator [R=301,L,NE,QSD]

    # Keep specific generator endpoints addressable by their exact PHP paths.
    RewriteRule ^admin/manageBookQuestions/(?:generate_from_book|api)\.php$ - [L,NC]
    RewriteRule ^admin/manageAIcontent/test_mcq_generation\.php$ - [L,NC]
    RewriteRule ^quiz/test_nvidia_direct\.php$ - [L,NC]

    # Application internals are not public content.
    RewriteRule ^(?:tests?|database|migrations|cron|logs|storage|scratch|config|includes|middleware|repositories|services)(?:/|$) - [F,L,NC]
    RewriteRule ^payment/(?:run_migration|migrate_database|fix_payment_status|manual_verify_payment)\.php$ - [F,L,NC]
    RewriteRule ^quiz/(?:show_mcqs_table|setup_quiz_enhancements|setup_lobby_system|test_[^/]+)\.php$ - [F,L,NC]

    # Class/book live quiz URL, e.g. /class-9-physics-mcqs-test-2026
    RewriteRule ^class-([0-9]+)-([a-zA-Z0-9-]+)-mcqs-test-2026/?$ quiz/quiz.php?class_name=$1&book_name=$2 [QSA,NC,L]

    # Handle clean Class/Book quiz URLs, e.g. /9-biology
    RewriteRule ^([0-9]+)-([a-zA-Z0-9-]+)/?$ quiz/quiz.php?class_name=$1&book_name=$2 [QSA,NC,L]

    # 8. Handle SEO pattern for Class/Book based Quiz
    # Matches patterns like: 9th/math/1-MCQs-quiz or 9th/math/All-Chapter-MCQs-quiz
    RewriteRule ^([a-zA-Z0-9-]+)/([a-zA-Z0-9-]+)/([a-zA-Z0-9-]+)-MCQs-quiz/?$ quiz/quiz.php?class_name=$1&book_name=$2&chapters_from_url=$3 [QSA,NC,L]

    # 7. Handle SEO pattern for Topic-based Quiz
    # Matches patterns like: Thread-Concepts-MCQs-Quiz
    RewriteRule ^([^/]+)-MCQs-Quiz/?$ quiz/quiz.php?topic=$1 [QSA,NC,L]

    # Specific SEO rule for quiz_setup.php
    RewriteCond %{THE_REQUEST} /quiz/quiz_setup\.php [NC,OR]
    RewriteCond %{THE_REQUEST} /quiz_setup [NC]
    RewriteRule ^(quiz/)?quiz_setup(\.php)?$ /class-9-and-10-online-mcqs-prepation-test [R=301,L]
    RewriteRule ^class-9-and-10-online-mcqs-prepation-test/?$ quiz/quiz_setup.php [NC,L]
    RewriteRule ^online-mcqs-test-for-9th-and-10th-board-exams/?$ quiz/quiz_setup.php [NC,L]

    # Specific SEO rule for quiz_setup_inter.php
    RewriteCond %{THE_REQUEST} /quiz/quiz_setup_inter\.php [NC,OR]
    RewriteCond %{THE_REQUEST} /quiz_setup_inter [NC]
    RewriteRule ^(quiz/)?quiz_setup_inter(\.php)?$ /class-11-and-12-online-mcqs-prepation-test [R=301,L]
    RewriteRule ^class-11-and-12-online-mcqs-prepation-test/?$ quiz/quiz_setup_inter.php [NC,L]


    # Redirect old URLs with query params OR trailing number to clean URLs
    RewriteCond %{THE_REQUEST} \s/+class-([0-9]+)-([a-zA-Z0-9-]+)-mcqs\?mcq_count=([0-9]+)&class_id=([0-9]+)&book_id=([0-9]+)\s [NC]
    RewriteRule ^class-([0-9]+)-([a-zA-Z0-9-]+)-mcqs/?$ /class-$1-$2-mcqs? [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+class-([0-9]+)-([a-zA-Z0-9-]+)-mcqs/([0-9]+)\s [NC]
    RewriteRule ^class-([0-9]+)-([a-zA-Z0-9-]+)-mcqs/([0-9]+)/?$ /class-$1-$2-mcqs? [R=301,L]
    # SEO rule for class-{number}-{subject}-mcqs (no trailing number)
    RewriteRule ^class-([0-9]+)-([a-zA-Z0-9-]+)-mcqs/?$ quiz/mcqs-quiz.php?class_slug=$1&book_slug=$2 [QSA,NC,L]

    # Specific SEO rule for mcqs_topic.php
    RewriteCond %{THE_REQUEST} /quiz/mcqs_topic\.php [NC,OR]
    RewriteCond %{THE_REQUEST} /mcqs_topic [NC]
    RewriteRule ^(quiz/)?mcqs_topic(\.php)?$ /topic-wise-mcqs-test [R=301,L]
    RewriteRule ^topic-wise-mcqs-test/?$ quiz/mcqs_topic.php [NC,L]

    # Public live quiz hosting landing page. Keep the old slug as a single-hop 301.
    RewriteCond %{THE_REQUEST} \s/+quiz-host-index(?:\.php)?(?:[\s?/]|\s) [NC]
    RewriteRule ^(?:quiz/)?quiz-host-index(?:\.php)?$ /online-quiz-hosting [R=301,L]
    RewriteRule ^online-quiz-hosting/?$ quiz/quiz-host-index.php [NC,L]

    # 1. Map root-level requests to 'quiz/' folder
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/quiz/$1.php -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/quiz/$1 -f
    RewriteRule ^([^/]+)$ quiz/$1 [L]

    # 2. Map root-level requests to 'questionPaperFromTopic/' folder
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/questionPaperFromTopic/$1.php -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/questionPaperFromTopic/$1 -f
    RewriteRule ^([^/]+)$ questionPaperFromTopic/$1 [L]

    # Specific SEO rule for study materials page
    RewriteCond %{THE_REQUEST} \s/+(notes/note\.php|note)(?:[\s?/]|\s) [NC]
    RewriteRule ^(?:notes/note\.php|note)/?$ /study-material-for-board-exam-preparations [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+study-material-for-board-exam-preparations/+\s [NC]
    RewriteRule ^study-material-for-board-exam-preparations/+$ /study-material-for-board-exam-preparations [R=301,L]
    RewriteRule ^study-material-for-board-exam-preparations/?$ notes/note.php [NC,L]

    # Specific SEO rules for Class Notes (uploadingNotesForClasses)
    RewriteCond %{THE_REQUEST} \s/+uploadingNotesForClasses(?:/(?:index\.php)?)?(?:[\s?/]|\s) [NC]
    RewriteRule ^uploadingNotesForClasses(?:/(?:index\.php)?)?$ /class-notes [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+uploadingNotesForClasses/upload_note\.php(?:[\s?/]|\s) [NC]
    RewriteRule ^uploadingNotesForClasses/upload_note\.php$ /upload-notes [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+uploadingNotesForClasses/download_note\.php(?:[\s?/]|\s) [NC]
    RewriteRule ^uploadingNotesForClasses/download_note\.php$ /download-note [R=301,L]

    RewriteRule ^class-notes/view/([0-9]+)/?$ uploadingNotesForClasses/view_note.php?id=$1 [QSA,NC,L]
    RewriteRule ^class-notes/class-([0-9]+)-([^/]+)-(.+)-([0-9]+)/?$ uploadingNotesForClasses/view_note.php?id=$4&seo=1 [QSA,NC,L]
    RewriteRule ^class-notes/class-([0-9]+)-notes/?$ uploadingNotesForClasses/index.php?class=$1 [QSA,NC,L]
    RewriteRule ^class-notes/class-([0-9]+)-(.+)-notes/?$ uploadingNotesForClasses/index.php?class=$1&subject_slug=$2 [QSA,NC,L]
    RewriteRule ^class-notes/?$ uploadingNotesForClasses/index.php [QSA,NC,L]
    RewriteRule ^class-notes/([0-9]+)/?$ uploadingNotesForClasses/index.php?class=$1 [QSA,NC,L]
    RewriteRule ^upload-notes/?$ uploadingNotesForClasses/upload_note.php [QSA,NC,L]
    RewriteRule ^download-note/?$ uploadingNotesForClasses/download_note.php [QSA,NC,L]

    # 3. Map root-level requests to 'notes/' folder
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/notes/$1.php -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/notes/$1 -f
    RewriteRule ^([^/]+)$ notes/$1 [L]

    # 4. Map root-level requests to 'auth/' folder
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/auth/$1.php -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/auth/$1 -f
    RewriteRule ^([^/]+)$ auth/$1 [L]

    # 5. Handle SEO pattern for class/book question paper generator
    # Matches patterns like: 10th-class-physics-chapter-1-2-mcqs-12-short-24-long-3-question-paper-generator
    RewriteRule ^([0-9]+)(?:st|nd|rd|th)-class-([a-zA-Z0-9-]+)-(?:chapter-([a-zA-Z0-9,%\s\-]+)-)?mcqs-([0-9]+)-short-([0-9]+)-long-([0-9]+)-question-paper-generator/?$ generate_question_paper.php?class_id=$1&book_name=$2&chapters_from_url=$3&total_mcqs=$4&total_shorts=$5&total_longs=$6 [QSA,NC,L]

    # Matches patterns like: 10th-class-physics-question-paper-generator
    RewriteRule ^([0-9]+)(?:st|nd|rd|th)-class-([a-zA-Z0-9-]+)-question-paper-generator/?$ select_chapters.php?class_id=$1&book_name=$2 [QSA,NC,L]

    # The chapter selector requires class_id and book_name. A bare legacy
    # request is not a usable page, so send it directly to the public entry
    # page instead of allowing a redirect chain through select_class.php.
    RewriteCond %{THE_REQUEST} \s/+select_chapters\.php(?:\s|$) [NC]
    RewriteRule ^select_chapters\.php$ /class-9th-and-10th-online-question-paper-generator [R=301,L]

    # Matches patterns like: 10th-class-physics-chapter-1-2-question-paper-generator or 10th-class-physics-all-chapter-question-paper-generator
    # These point to question selection
    RewriteRule ^([0-9]+)(?:st|nd|rd|th)-class-([a-zA-Z0-9-]+)-chapter-([a-zA-Z0-9,%\s\-]+)-question-paper-generator/?$ select_question.php?class_id=$1&book_name=$2&chapters_from_url=$3 [QSA,NC,L]
    RewriteRule ^([0-9]+)(?:st|nd|rd|th)-class-([a-zA-Z0-9-]+)-all-chapter-question-paper-generator/?$ select_question.php?class_id=$1&book_name=$2&chapters_from_url=all [QSA,NC,L]

    # Specific SEO rule for select_class.php (9/10)
    RewriteRule ^Class-9-and-10-Online-Question-Paper-generator/?$ select_class.php [NC,L]
    RewriteRule ^class-9th-and-10th-online-question-paper-generator/?$ select_class.php [NC,L]

    # Specific SEO rule for select_class_11-12.php
    RewriteCond %{THE_REQUEST} \s/+Class-11-and-12-Online-Question-Paper-generator[\s?/]
    RewriteRule ^Class-11-and-12-Online-Question-Paper-generator/?$ /class-11-and-12-online-question-paper-generator [R=301,L]
    RewriteRule ^class-11-and-12-online-question-paper-generator/?$ select_class_11-12.php [NC,L]

    # Specific SEO rule for select_book.php (per class)
    RewriteRule ^class-([0-9]+)-online-question-paper-generator/?$ select_book.php?class_id=$1 [QSA,NC,L]

    # Specific SEO rule for AI Topic Paper Generator (questionPaperFromTopic/home.php)
    RewriteCond %{THE_REQUEST} /questionPaperFromTopic/home\.php [NC]
    RewriteRule ^questionPaperFromTopic/home\.php$ /online-question-paper-generator [R=301,L]
    RewriteRule ^online-question-paper-generator/?$ questionPaperFromTopic/home.php [NC,L]

    # Specific SEO rules for AI Topic Paper Finalizer (questionPaperFromTopic/finalize_paper.php)
    RewriteRule ^online-mcqs-question-paper-generator/?$ questionPaperFromTopic/finalize_paper.php [NC,L]
    RewriteRule ^online-short-question-paper-generator/?$ questionPaperFromTopic/finalize_paper.php [NC,L]
    RewriteRule ^online-long-question-paper-generator/?$ questionPaperFromTopic/finalize_paper.php [NC,L]
    RewriteRule ^online-mcqs-short-and-long-question-paper-generator/?$ questionPaperFromTopic/finalize_paper.php [NC,L]

    # 5. Map root-level requests to 'examPreparation/' folder
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/examPreparation/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/examPreparation/$1.php -f
    RewriteRule ^([^/]+)$ examPreparation/$1 [L]

    # 6. Handle SEO pattern for MCQs page
    RewriteRule ^class-9-10-11-12-mcqs-for-board-exams/?$ notes/Mcqs/index.php [NC,L]
    RewriteRule ^class-?([0-9]+)-all-subjects-mcqs-with-explanations/?$ notes/Mcqs/books.php?class_id=$1 [QSA,NC,L]
    RewriteRule ^class-?([0-9]+)-all-subjects-mcqs-with-answers/?$ /class-$1-all-subjects-mcqs-with-explanations [R=301,L]
    RewriteCond %{QUERY_STRING} (^|&)page=[^&]+(&|$) [NC]
    RewriteRule ^class-?([0-9]+)-([a-zA-Z0-9-]+)-chapter-wise-mcqs-with-explanations/?$ /class-$1-$2-chapter-wise-mcqs-with-explanations [R=301,L,NE,QSD]
    RewriteRule ^class-?([0-9]+)-([a-zA-Z0-9-]+)-chapter-wise-mcqs-with-explanations/?$ notes/Mcqs/chapters.php?class_id=$1&book_name=$2 [QSA,NC,L]
    RewriteRule ^class-?([0-9]+)-([a-zA-Z0-9-]+)-chapter-wise-mcqs-with-answers/?$ /class-$1-$2-chapter-wise-mcqs-with-explanations [R=301,L]
    # Chapter slugs contain the book slug followed by -chapter-. Pass the
    # complete tail to the resolver so a greedy regex cannot split the book
    # and chapter at the wrong hyphen.
    RewriteRule ^class-?([0-9]+)-(.+)-mcqs-with-explanations/?$ notes/Mcqs/chapter.php?class_id=$1&book_name=$2 [QSA,NC,L]
    RewriteRule ^class-?([0-9]+)-([a-zA-Z0-9-]+)-(.+)-mcqs-with-explanations/?$ notes/Mcqs/chapter.php?class_id=$1&book_name=$2&chapter_slug=$3 [QSA,NC,L]
    RewriteRule ^class-?([0-9]+)-([a-zA-Z0-9-]+)-(.+)-mcqs-with-answers/?$ /class-$1-$2-$3-mcqs-with-explanations [R=301,L]
    RewriteRule ^mcqs/([0-9]+)(?:st|nd|rd|th)-class/([a-zA-Z0-9-]+)/?$ /class-$1-$2-chapter-wise-mcqs-with-explanations [R=301,L,QSD]

    # Matches patterns like: mcqs/9th-class/physics
    RewriteRule ^mcqs/([0-9]+)(?:st|nd|rd|th)-class/([a-zA-Z0-9-]+)/?$ notes/mcqs.php?class_id=$1&book_name=$2&view=1 [QSA,NC,L]

    # 9. Exam Preparation SEO Rules
    RewriteCond %{THE_REQUEST} \s/+examPreparation/select_class_for_test\.php[\s?] [NC]
    RewriteRule ^examPreparation/select_class_for_test\.php$ /class-9-10-11-12-test-series-for-board-exams [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+online-test-papers-preparation[\s?/] [NC]
    RewriteRule ^online-test-papers-preparation/?$ /class-9-10-11-12-test-series-for-board-exams [R=301,L]

    # Level-specific SEO entry points
    RewriteRule ^Class-9-10-pastPaper-&-Test-Papers/?$ /class-9-10-pastpaper-and-test-papers [R=301,L,NE]
    RewriteRule ^Class-11-12-pastPaper-&-Test-Papers/?$ /class-11-12-pastpaper-and-test-papers [R=301,L,NE]
    RewriteRule ^University-pastPaper-&-Test-Papers/?$ /university-pastpaper-and-test-papers [R=301,L,NE]
    RewriteRule ^class-9-10-pastpaper-and-test-papers/?$ examPreparation/select_class_for_test.php?level=School [NC,L]
    RewriteRule ^class-11-12-pastpaper-and-test-papers/?$ examPreparation/select_class_for_test.php?level=College [NC,L]
    RewriteRule ^university-pastpaper-and-test-papers/?$ examPreparation/select_class_for_test.php?level=University [NC,L]
    
    # Matches /past-papers or /online-test-papers (General fallback)
    RewriteRule ^class-9-10-11-12-test-series-for-board-exams/?$ examPreparation/select_class_for_test.php [NC,L]
    RewriteRule ^online-test-papers-preparation/?$ examPreparation/select_class_for_test.php [NC,L]
    
    # Matches /class-9-all-subjects-test-series-with-solutions (Class Subject Selection)
    RewriteRule ^class-?([0-9]+)-all-subjects-test-series-with-solutions/?$ examPreparation/select_book_for_test.php?class_id=$1 [QSA,NC,L]
    RewriteRule ^class-?([0-9]+)-chapterWise-test-series/?$ /class-$1-all-subjects-test-series-with-solutions [R=301,L]

    # Matches /class-10-physics-chapterwise-test-series-with-solutions (Chapter Selection)
    RewriteRule ^class-?([0-9]+)-([a-zA-Z0-9-]+)-chapterWise-test-series-with-solutions/?$ /class-$1-$2-chapterwise-test-series-with-solutions [R=301,L]
    RewriteRule ^class-?([0-9]+)-([a-zA-Z0-9-]+)-chapterwise-test-series-with-solutions/?$ examPreparation/select_chapters_for_test.php?class_id=$1&book_name=$2 [QSA,NC,L]
    RewriteRule ^class-?([0-9]+)-([a-zA-Z0-9-]+)-chapterWise-test-series/?$ /class-$1-$2-chapterwise-test-series-with-solutions [R=301,L]

    # Matches /class-9-Physics-chapterWise-test-series (legacy Subject Selection)
    RewriteRule ^class-?([0-9]+)-([a-zA-Z0-9-]+)-chapterWise-test-series/?$ examPreparation/select_chapters_for_test.php?class_id=$1&book_name=$2 [QSA,NC,L]

    # Matches /class9-chapterWise-test-series or /9th-class-chapterWise-test-series (Class Selection)
    RewriteRule ^([a-zA-Z0-9-]+)-chapterWise-test-series/?$ examPreparation/select_book_for_test.php?class_slug=$1 [QSA,NC,L]
    
    # Matches /class-10-Physics-selected-test-title-with-solutions (Pre-created Exams)
    RewriteRule ^class-?([0-9]+)-([a-zA-Z0-9-]+)-(.+)-with-solutions/?$ examPreparation/take_test.php?class_id=$1&book_name=$2&test_title=$3 [QSA,NC,L]

    # Matches /class-10-Physics-chapterWise-test-series-Online-Test-2 (Legacy Pre-created Exams)
    RewriteRule ^class-?([0-9]+)-([a-zA-Z0-9-]+)-chapterWise-test-series-Online-Test-([0-9]+)/?$ examPreparation/take_test.php?class_id=$1&book_name=$2&exam_id=$3 [QSA,NC,L]

    # Matches /class-9-Physics-Chapter-1-Test (Custom Chapters)
    RewriteRule ^class-?([0-9]+)-([a-zA-Z0-9-]+)-Chapter-([0-9-]+)-Test/?$ examPreparation/take_test.php?class_id=$1&book_name=$2&chapter_ids=$3&custom=1 [QSA,NC,L]

    # 4. Hide .php extensions for a cleaner URL structure (General Root Files)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [NC,L]
</IfModule>

<IfModule mod_headers.c>
    # Keep private, transactional and state-dependent pages out of search results.
    SetEnvIf Request_URI "^/(?:auth|admin|payment|email|oauth|profile|settings|subscription)(?:/|\.php|$)" alh_noindex
    SetEnvIf Request_URI "^/(?:questionPaperFromTopic/finalize_paper\.php|online-(?:mcqs|short|long|mcqs-short-and-long)-question-paper-generator)(?:/|$)" alh_noindex
    SetEnvIf Request_URI "^/quiz/(?:online_quiz_(?:dashboard|lobby|take|participant|room_questions|create_room|save_answer|submit|start)|ajax_)" alh_noindex
    SetEnvIf Request_URI "^/(?:generate_question_paper|google_drive_callback|download_docx?|contact_handler|newsletter-signup|review_vote)\.php" alh_noindex
    Header always set X-Robots-Tag "noindex, nofollow, noarchive" env=alh_noindex
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
