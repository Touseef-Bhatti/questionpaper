# -------------------------------------------------------------
# 🔒 Project .gitignore — AhmadLearninghub / Questionpaper
# Keep sensitive credentials, storage caches, dumps & temp files out of Git
# -------------------------------------------------------------

# 🧩 Environment & Secrets (Never commit real credentials)
.env
.env.*
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!config/.env.template
!config/.env.example
!*.env.template
!*.env.example

# Root env file (if any created locally)
/env.php

# 🔑 Service Accounts, OAuth Tokens & Private Keys
*.pem
*.key
*.p12
*.pfx
*service_account*.json
*client_secret*.json
*credentials*.json
credentials.json
/config/google_service_account*.json
/config/gdrive_*.json
/config/*credentials*.json
/config/*client_secret*.json
/storage/*.json
/storage/*.token
!/storage/*.json.example

# 🗄️ Databases & Backups
*.sql
*.sql.gz
*.sqlite
*.sqlite3
*.db
dump/
backup/
backups/

# 📦 Dependencies
vendor/
node_modules/

# 🧠 Build & Cache Outputs
dist/
build/
.cache/
.tmp/
coverage/

# 📂 Global Cache (AI MCQs, questions, topics)
/cache/*
!/cache/.gitkeep

# 📤 Storage, Uploads & PDF Generation Caches
/uploads/*
!/uploads/.gitkeep
/logs/*
!/logs/.gitkeep

/storage/ai_uploads/*
!/storage/ai_uploads/.gitkeep

/storage/ai_upload_context/*
!/storage/ai_upload_context/.gitkeep

/storage/book_uploads/*
!/storage/book_uploads/.gitkeep

/storage/book_generation/*
!/storage/book_generation/.gitkeep
!/storage/book_generation/**/.gitkeep

/storage/pdf_extraction_cache/*
!/storage/pdf_extraction_cache/.gitkeep

/storage/temp/*
!/storage/temp/.gitkeep

# Keep storage htaccess protected
!/storage/.htaccess
!/config/.htaccess

# 🖥️ IDE & Editor Settings
.vscode/
.idea/
.cursor/
*.swp
*.swo
*.sublime-*

# 🧱 OS Artifacts
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
Desktop.ini
$RECYCLE.BIN/

# 🔍 Logs & Runtime Errors
*.log
error_log
php_errors.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 🧰 Miscellaneous
ads.php
*.bak
*.tmp
